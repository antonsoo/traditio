{
  "name": "@antonsoloviev/traditio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Change a fact in Gaius's Roman ownership cases and trace possession, title, and the Latin that separates them.",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/traditio.git"
  },
  "homepage": "https://antonsoo.github.io/traditio/",
  "keywords": [
    "roman-law",
    "latin",
    "gaius",
    "legal-history",
    "education",
    "usucapio",
    "interactive-learning"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4368 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4367 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:sources && npm run build",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:browser": "node scripts/browser.mjs",
    "test:audit": "node scripts/audit-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
